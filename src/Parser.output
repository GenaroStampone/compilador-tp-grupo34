  22  declaracion_funcion : cabecera_funcion bloque_declarativo BEGIN lista_sentencias END ';'

  23  cabecera_funcion : type_specifier FUNCTION ID '(' lista_parametros_formales ')'

  24  lista_parametros_formales : type_specifier ID
