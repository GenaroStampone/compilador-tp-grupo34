  26  declaracion_clase : encabezado_clase herencia_opcional cuerpo_clase

  27  encabezado_clase : CLASS ID

  28  herencia_opcional : EXTENDS lista_variables ';'
  29                    |

  30  cuerpo_clase : BEGIN lista_miembros END ';'

  31  lista_miembros : lista_miembros miembro_clase
  32                 |

  33  miembro_clase : type_specifier lista_variables ';'
  34                | PRIVATE type_specifier lista_variables ';'
  35                | cabecera_metodo bloque_declarativo BEGIN lista_sentencias END ';'
  36                | FRIEND ID ';'
  37                | EXTENDS lista_variables ';'
  38                | error ';'

  39  cabecera_metodo : type_specifier FUNCTION ID '(' lista_parametros_formales ')'
  40                  | PRIVATE type_specifier FUNCTION ID '(' lista_parametros_formales ')'
  41                  | type_specifier ID '(' lista_parametros_formales ')'
  42                  | PRIVATE type_specifier ID '(' lista_parametros_formales ')'

  43  bloque_compuesto : sentencia
  44                   | BEGIN lista_sentencias END ';'

  45  lista_sentencias : lista_sentencias sentencia
  46                   |

  47  sentencia : asignacion
  48            | salida_pout ';'
  49            | sentencia_if
  50            | sentencia_while
  51            | sentencia_retorno
  52            | error ';'

  53  asignacion : ID ASIGNACION expresion ';'
  54             | ID CORCHETE_IZQ expresion CORCHETE_DER ASIGNACION expresion ';'

  55  sentencia_if : IF '(' condicion ')' bloque_compuesto rama_else END_IF ';'

  56  rama_else : ELSE bloque_compuesto
  57            |

  58  sentencia_while : WHILE '(' condicion ')' REPEAT bloque_compuesto

  59  sentencia_retorno : RET '(' expresion ')' ';'

  60  salida_pout : POUT '(' CADENA ')'
  61              | POUT '(' expresion ')'

  62  condicion : expresion comparador expresion

  63  comparador : COMP_IGUAL
