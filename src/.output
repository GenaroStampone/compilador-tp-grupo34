  19                             | error ';'

  20  declaracion_variables : tipo lista_variables

  21  tipo : USHORTINT
  22       | DOUBLEF
  23       | ID

  24  tipo_basico : USHORTINT
  25              | DOUBLEF

  26  lista_variables : ID
  27                  | lista_variables ',' ID

  28  declaracion_tipo : TYPEDEF ID '=' '[' lista_constantes ']'

  29  lista_constantes : constante
  30                   | lista_constantes ',' constante

  31  constante : CTE_ENTERA
  32            | DOUBLEF_VAL
  33            | '-' DOUBLEF_VAL

  34  declaracion_clase : CLASS ID BEGIN miembros_clase END

  35  miembros_clase :
  36                 | miembros_clase miembro_clase

  37  miembro_clase : sentencia_declarativa
  38                | PRIVATE sentencia_declarativa
  39                | FRIEND ID ';'
  40                | EXTENDS lista_ids ';'

  41  lista_ids : ID
  42            | lista_ids ',' ID

  43  declaracion_funcion : tipo FUNCTION ID '(' lista_parametros ')' sentencias_declarativas BEGIN sentencias_ejecutables END
  44                      | FUNCTION tipo ID '(' lista_parametros ')' sentencias_declarativas BEGIN sentencias_ejecutables END
  45                      | tipo ID '(' lista_parametros ')' sentencias_declarativas BEGIN sentencias_ejecutables END

  46  declaracion_funcion_sin_id : tipo_basico FUNCTION ID '(' lista_parametros ')' sentencias_declarativas BEGIN sentencias_ejecutables END
  47                             | FUNCTION tipo ID '(' lista_parametros ')' sentencias_declarativas BEGIN sentencias_ejecutables END
  48                             | tipo_basico ID '(' lista_parametros ')' sentencias_declarativas BEGIN sentencias_ejecutables END

  49  lista_parametros :
  50                   | lista_parametros_no_vacia

  51  lista_parametros_no_vacia : parametro
  52                            | lista_parametros_no_vacia ',' parametro

  53  parametro : tipo ID

  54  sentencias_ejecutables :
  55                         | sentencias_ejecutables sentencia_ejecutable

  56  sentencia_ejecutable : sentencia_asignacion ';'
  57                       | llamada_funcion ';'
  58                       | sentencia_if
  59                       | sentencia_while
  60                       | sentencia_pout ';'
  61                       | sentencia_ret ';'
  62                       | bloque_compuesto
  63                       | error ';'

  64  bloque_compuesto : BEGIN sentencias_ejecutables END opt_punto_y_coma

  65  sentencia_asignacion : lado_izquierdo ASIGNACION expresion
  66                       | lado_izquierdo '=' expresion

  67  llamada_funcion : invocacion_funcion

  68  lado_izquierdo : ID
  69                 | ID '.' ID
  70                 | ID '[' expresion ']'
  71                 | ID '.' ID '[' expresion ']'

  72  sentencia_if : IF '(' condicion ')' opt_then sentencias_ejecutables END_IF ';'
  73               | IF '(' condicion ')' opt_then sentencias_ejecutables ELSE sentencias_ejecutables END_IF ';'

  74  opt_then : THEN
  75           |

  76  sentencia_while : WHILE '(' condicion ')' REPEAT sentencia_ejecutable

  77  sentencia_pout : POUT '(' CADENA ')'
  78                 | POUT '(' expresion ')'
  79                 | POUT CADENA

  80  sentencia_ret : RET '(' expresion ')'
  81                | RET

  82  condicion : expresion comparador expresion
  83            | expresion

  84  comparador : MAYOR_IGUAL
  85             | MENOR_IGUAL
  86             | IGUAL_IGUAL
  87             | DISTINTO
  88             | '>'
  89             | '<'

  90  expresion : expresion '+' expresion
  91            | expresion '-' expresion
  92            | expresion '*' expresion
  93            | expresion '/' expresion
  94            | '-' expresion
  95            | ID '=' expresion
  96            | '(' expresion ')'
  97            | invocacion_funcion
  98            | conversion_tipo
  99            | elemento_primario

 100  elemento_primario : ID
 101                    | ID '.' ID
 102                    | ID '[' expresion ']'
 103                    | ID '.' ID '[' expresion ']'
 104                    | CTE_ENTERA
 105                    | DOUBLEF_VAL

 106  invocacion_funcion : ID '(' lista_argumentos ')' opt_orden_evaluacion
 107                     | ID '(' ')' opt_orden_evaluacion
 108                     | ID '.' ID '(' lista_argumentos ')' opt_orden_evaluacion
 109                     | ID '.' ID '(' ')' opt_orden_evaluacion

 110  lista_argumentos : expresion
 111                   | lista_argumentos ',' expresion

 112  opt_orden_evaluacion : '[' lista_constantes ']'
 113                       |

 114  conversion_tipo : TODF '(' expresion ')'
