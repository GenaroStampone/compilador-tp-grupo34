  63            | expresion '/' expresion
  64            | '-' expresion
  65            | ID '=' expresion
  66            | ID invocacion_ordenada
  67            | ID CORCHETE_IZQ expresion CORCHETE_DER
  68            | ID
  69            | constante

  70  invocacion_ordenada : '(' lista_expresiones ')' CORCHETE_IZQ lista_valores CORCHETE_DER
  71                      | '(' lista_expresiones ')'

  72  lista_expresiones : expresion
  73                    | lista_expresiones ',' expresion
  74                    |

  75  constante : CTE_USHORT
