  27                | FRIEND lista_variables ';'
  28                | EXTENDS lista_variables ';'

  29  visibilidad : PRIVATE

  30  declaracion_funcion : type_specifier FUNCTION ID '(' parametros ')' bloque_declarativo BEGIN bloque_ejecutable retorno_opcional END ';'

  31  parametros : type_specifier ID
