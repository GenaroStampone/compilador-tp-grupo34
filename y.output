  44  sentencia_while : WHILE '(' condicion ')' REPEAT bloque_ejecutable END

  45  sentencia_if : IF '(' condicion ')' bloque_ejecutable rama_else END_IF

  46  rama_else : ELSE bloque_ejecutable
  47            |

  48  salida_pout : POUT '(' CADENA ')'
