   0  $accept : programa $end

   1  programa : ID ';' bloque_declarativo cuerpo_ejecutable ';'
   2           | ID bloque_declarativo cuerpo_ejecutable ';'

   3  bloque_declarativo : bloque_declarativo declaracion
   4                     |

   5  declaracion : type_specifier lista_variables ';'
   6              | declaracion_typedef
   7              | declaracion_clase
   8              | declaracion_funcion
   9              | error ';'

  10  type_specifier : USHORTINT
  11                 | DOUBLEF
  12                 | ID

  13  lista_variables : ID
  14                  | lista_variables ',' ID

  15  declaracion_typedef : TYPEDEF ID '=' CORCHETE_IZQ lista_valores CORCHETE_DER ';'

  16  lista_valores : valor_enum
  17                | lista_valores ',' valor_enum

  18  valor_enum : constante
  19             | '-' constante

  20  declaracion_clase : CLASS ID herencia_opcional BEGIN cuerpo_clase END ';'

  21  herencia_opcional : EXTENDS lista_variables
  22                    |

  23  cuerpo_clase : cuerpo_clase miembro_clase
  24               |

  25  miembro_clase : visibilidad declaracion
  26                | declaracion
  27                | FRIEND lista_variables ';'
  28                | EXTENDS lista_variables ';'

  29  visibilidad : PRIVATE

  30  declaracion_funcion : type_specifier FUNCTION ID '(' parametros ')' bloque_declarativo BEGIN lista_sentencias retorno_opcional END ';'

  31  parametros : type_specifier ID
  32             | parametros ',' type_specifier ID

  33  retorno_opcional : RET '(' expresion ')' ';'
  34                   |

  35  cuerpo_ejecutable : sentencia
  36                    | bloque_compuesto

  37  bloque_compuesto : BEGIN lista_sentencias END

  38  lista_sentencias : lista_sentencias sentencia
  39                   |

  40  sentencia : asignacion ';'
  41            | sentencia_while ';'
  42            | sentencia_if ';'
  43            | salida_pout ';'
  44            | error ';'

  45  asignacion : ID ASIGNACION expresion
  46             | ID CORCHETE_IZQ expresion CORCHETE_DER ASIGNACION expresion

  47  sentencia_while : WHILE '(' condicion ')' REPEAT cuerpo_ejecutable

  48  sentencia_if : IF '(' condicion ')' cuerpo_ejecutable rama_else END_IF

  49  rama_else : ELSE cuerpo_ejecutable
  50            |

  51  salida_pout : POUT '(' CADENA ')'
  52              | POUT '(' expresion ')'

  53  condicion : expresion comparador expresion

  54  comparador : COMP_IGUAL
  55             | COMP_DIST
  56             | COMP_MAYOR_IGUAL
  57             | COMP_MENOR_IGUAL
  58             | '>'
  59             | '<'

  60  expresion : expresion '+' expresion
  61            | expresion '-' expresion
