  56  sentencia_if : IF '(' condicion ')' bloque_compuesto rama_else END_IF ';'

  57  rama_else : ELSE bloque_compuesto
  58            |

  59  sentencia_while : WHILE '(' condicion ')' REPEAT bloque_compuesto
